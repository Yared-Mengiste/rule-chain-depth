# Copy to .env and set the key there. .env is ignored and never copied to results.
OPENAI_API_KEY=
OPENAI_MODEL=openai/gpt-4o-mini
PARSER=canonical_pln
OLLAMA_URL=http://127.0.0.1:11434/api/embeddings
OLLAMA_MODEL=nomic-embed-text
B1_QDRANT_URL=http://127.0.0.1:16333
B1_QUERY_TIMEOUT=180
B1_LEARN_TIMEOUT=900
B1_REASONING_TIMEOUT=30
B1_LLM_TIMEOUT=60
# For OpenRouter, put its key in OPENAI_API_KEY and select a DSPy model prefix:
# OPENAI_MODEL=openrouter/nvidia/nemotron-3-super-120b-a12b:free
# OPENROUTER_PROVIDER=nvidia
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
B1_LLM_TEMPERATURE=0
B1_LLM_MAX_TOKENS=2000
# OpenRouter defaults to a 40-request cap and 4-second spacing when omitted.
# B1_MAX_LLM_CALLS=40
# B1_LLM_MIN_INTERVAL=4
# Shared benchmark: all selected systems use the settings above and ONE cap.
# Full 40-question / three-system run: roughly 380 calls before extra PLN calls.
# Choose a cap within your account allowance; this example is not a dollar budget:
# B1_MAX_LLM_CALLS=500
B1_EMBEDDING_TIMEOUT=30
